import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { readFile } from "node:fs/promises";
import type { ModuleOperationPlan, OperationResult } from "./src/lib/module-manager/operation.types";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { modelService, modelClientConfig, withActor } = await import("./src/lib/modules/registry");
const { hashPassword } = await import("./src/lib/auth/password");

// Disposable accounts in the temporary schema only.
const password = await hashPassword("extension-test-only");
const root = await prisma.user.create({ data: { login: "extension-root", password, isAdmin: true } });
const reader = await prisma.user.create({ data: { login: "extension-reader", password } });
await prisma.accessUserGroup.create({ data: { userId: reader.id, groupId: "taller.lector" } });
const actor = { id: root.id, sessionVersion: root.sessionVersion };
const lector = { id: reader.id, sessionVersion: reader.sessionVersion };
type Saved = Record<string, unknown> & { id: string; revision: string };
const ok = <T extends { ok: boolean }>(result: T, step: string) => { assert.ok(result.ok, `${step}: ${JSON.stringify(result)}`); return result as T & { values: Saved }; };
const equipos = modelService("taller.equipo");
// Raw SQL for the companion table: after the extension is dropped its Prisma delegate no
// longer exists, and the module manager type-checks the whole project.
const schema = new URL(process.env.DATABASE_URL!).searchParams.get("schema")!;
assert.match(schema, /^modules_test_[a-f0-9]+$/);
const companionTable = `"${schema}"."soporte_taller_equipo"`;
type Companion = { recordId: string; nivel: number; createBy: string | null };
const companions = () => prisma.$queryRawUnsafe<Companion[]>('SELECT record_id AS "recordId", nivel, create_by AS "createBy" FROM ' + companionTable + ' ORDER BY id');
const companionOf = async (id: string) => (await companions()).filter(row => row.recordId === id);

// A record that existed before Soporte was installed has no companion row: defaults are shown.
const legacyId = (process.argv[2] ?? "").trim();
assert.ok(legacyId, "falta el registro previo a la extensión");
const legacy = ok(await equipos.read(prisma, actor, legacyId), "leer registro previo");
assert.equal(legacy.values.name, "PREVIO");
assert.equal(legacy.values.responsable, null);
assert.equal(legacy.values.nivel, 1);
assert.equal((await companions()).length, 0);

// Saving it creates the companion row in the same write and advances the single revision.
const updated = ok(await equipos.save(prisma, actor, { ...legacy.values, responsable: "Ana", nivel: 2 }), "guardar con campos extendidos");
assert.notEqual(updated.values.revision, legacy.values.revision);
assert.equal(updated.values.responsable, "Ana");
const [row] = await companions();
assert.equal(row.recordId, legacyId);
assert.equal(row.nivel, 2);
assert.equal((await equipos.save(prisma, actor, { ...legacy.values, nivel: 3 })).ok, false, "revisión vieja rechazada");
assert.equal((await companions())[0].nivel, 2, "el rechazo no toca la fila compañera");

// Create: base rule (uppercase, from the base class) and extension rule (super) both apply.
const created = ok(await equipos.save(prisma, actor, { name: "taladro", estado: "activo", responsable: "Luis", nivel: 1 }), "crear");
assert.equal(created.values.name, "TALADRO");
assert.equal((await companionOf(created.values.id))[0]?.createBy, actor.id);
const before = await companions(), baseBefore = await prisma.tallerEquipo.findMany({ orderBy: { id: "asc" } });
const rejected = await equipos.save(prisma, actor, { ...created.values, estado: "baja", responsable: null });
assert.ok(!rejected.ok && "fieldErrors" in rejected && rejected.fieldErrors?.responsable, JSON.stringify(rejected));
assert.deepEqual(await companions(), before, "una regla de la extensión revierte también la base");
assert.deepEqual(await prisma.tallerEquipo.findMany({ orderBy: { id: "asc" } }), baseBefore);

// Actions declared by the extension write companion fields through the same pipeline.
const escalated = ok(await equipos.action(prisma, actor, { action: "escalar", id: created.values.id, revision: created.values.revision }), "acción de la extensión");
assert.equal(escalated.values.nivel, 2);
const history = ok(await equipos.activity(prisma, actor, { id: created.values.id }), "historial") as unknown as { data: { entries: { kind: string; changes: { field: string; after: unknown }[] }[] } };
assert.ok(history.data.entries.some(entry => entry.kind === "update" && entry.changes.some(change => change.field === "nivel" && change.after === 2)), JSON.stringify(history.data.entries));

// Access and rules are those of the base model: a reader sees extension fields but cannot write.
const read = ok(await equipos.read(prisma, lector, created.values.id), "lectura del lector");
assert.equal(read.values.responsable, "Luis");
assert.equal((await equipos.save(prisma, lector, { ...read.values, responsable: "Otro" })).ok, false, "lector no escribe campos extendidos");

// Client contract: one group per extension; collections stay on base fields (phase 1).
const client = modelClientConfig("taller.equipo");
assert.deepEqual(client.extensions, [{ module: "soporte", label: "Soporte", fields: ["responsable", "nivel", "etiqueta"] }]);
assert.ok(client.fields.responsable && client.preview.etiqueta);
assert.deepEqual(client.list.fields, ["name", "estado"]);
assert.deepEqual(client.actions, [{ name: "escalar", label: "Escalar" }]);
const list = ok(await withActor(actor, () => equipos.list(prisma, actor, { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] })), "lista") as unknown as { data: { rows: Record<string, unknown>[] } };
assert.equal(list.data.rows.length, 2);

// Deleting the base record deletes its companion row (Cascade).
const current = ok(await equipos.read(prisma, actor, created.values.id), "releer");
ok(await equipos.remove(prisma, actor, [{ id: current.values.id, revision: current.values.revision }]), "borrar");
assert.equal((await companionOf(created.values.id)).length, 0);
assert.equal((await companions()).length, 1);

// Module manager: the base cannot be uninstalled while extended; dropping the extension only
// drops its companion table and the inverse it owns inside the base schema.
const request = (body: Record<string, unknown>): OperationResult => {
  const result = spawnSync(process.execPath, ["--conditions=react-server", "--import", "tsx", "scripts/module-operation.ts", "--worker"], { cwd: process.cwd(), env: process.env, input: JSON.stringify({ ...body, actor }), encoding: "utf8", timeout: 300000 });
  if (result.error) throw result.error;
  const marker = result.stdout.lastIndexOf("MODULE_OPERATION_RESULT:");
  assert.ok(marker >= 0, result.stdout + result.stderr);
  return JSON.parse(result.stdout.slice(marker + "MODULE_OPERATION_RESULT:".length).trim());
};
const plan = (result: OperationResult): ModuleOperationPlan => { assert.ok(result.ok, JSON.stringify(result)); return result.plan; };
const base = plan(request({ command: "review", input: { module: "taller", operation: "uninstall", policy: "keep" } }));
assert.ok(base.blockers.length > 0, "desinstalar el base queda bloqueado por la extensión");
let drop = plan(request({ command: "review", input: { module: "soporte", operation: "uninstall", policy: "drop" } }));
assert.deepEqual(drop.blockers, [], JSON.stringify(drop));
assert.match(drop.sql, /DROP TABLE "soporte_taller_equipo"/);
assert.doesNotMatch(drop.sql, /DROP TABLE "taller_equipo"|ALTER TABLE "taller_equipo" DROP COLUMN/);
drop = plan(request({ command: "apply", id: drop.id, fingerprint: drop.fingerprint, confirmedModule: "soporte", maintenanceConfirmed: true }));
assert.equal(drop.phase, "complete", JSON.stringify(drop));
plan(request({ command: "finish", id: drop.id, maintenanceConfirmed: true }));
assert.equal((await prisma.$queryRawUnsafe<{ name: string | null }[]>("SELECT to_regclass($1)::text AS name", `${schema}.soporte_taller_equipo`))[0].name, null);
assert.equal(await prisma.tallerEquipo.count(), 1, "los datos del base se conservan");
assert.doesNotMatch(await readFile("prisma/models/orm-taller.prisma", "utf8"), /lite-erp:soporte/);
assert.equal(JSON.parse(await readFile("prisma/.orm-installations.json", "utf8")).modules.soporte, undefined);
await prisma.$disconnect();
console.log("✓ Gestor: desinstalar el base bloqueado; eliminar la extensión borra sólo su tabla compañera y su inversa, con respaldo.");
console.log("✓ Extensión: campos en tabla compañera, defaults sin fila previa, una revisión, super en hooks, acción, historial, accesos del base y borrado en cascada.");
