import "server-only";
import { defineModule } from "@/lib/modules/define";
import { Categoria } from "./models/categoria";
import { Tarea } from "./models/tarea";

/** Integration fixture for declarative modules; installed only in the disposable project/schema. */
export default defineModule({
  id: "ensayo",
  name: "Ensayo módulos",
  icon: "flask-conical",
  models: {
    tarea: {
      model: Tarea,
      kanban: { field: "estado", transitions: [
        { from: "pendiente", to: "curso", action: "iniciar" },
        { from: "pendiente", to: "hecha", action: "completar" },
        { from: "curso", to: "hecha", action: "completar" },
        { from: "hecha", to: "pendiente", action: "reabrir" },
      ] },
      views: {
        form: () => import("./views/TareaForm"),
        list: () => import("./views/TareaList"),
      },
    },
    categoria: Categoria,
  },
  menu: {
    Tareas: "tarea",
    Configuración: { Categorías: "categoria" },
  },

  // Control de accesos (como res.groups, ir.model.access e ir.rule de Odoo).
  groups: {
    usuario: "Usuario",
    responsable: { label: "Responsable", implies: ["usuario"] },
  },
  access: [
    { group: "usuario", models: "tarea", perms: "cru" },
    { group: "usuario", models: "categoria", perms: "r" },
    { group: "responsable", models: ["tarea", "categoria"], perms: "crud" },
  ],
  rules: [
    // Un usuario sólo ve y edita sus propias tareas; el responsable, todas (reglas de grupo con OR).
    { id: "tareas-propias", label: "Sólo mis tareas", models: "tarea", groups: ["usuario"], domain: ({ actor }) => [{ field: "createBy", operator: "eq", value: actor.id }] },
    { id: "tareas-todas", label: "Todas las tareas", models: "tarea", groups: ["responsable"], domain: [] },
    // Related records obey these too: an inactive category is shown empty to a usuario.
    { id: "categorias-activas", label: "Sólo categorías activas", models: "categoria", groups: ["usuario"], domain: [{ field: "active", operator: "eq", value: true }] },
    { id: "categorias-todas", label: "Todas las categorías", models: "categoria", groups: ["responsable"], domain: [] },
  ],
});
