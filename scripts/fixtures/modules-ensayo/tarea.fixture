import "server-only";
import { Fields, Model, ModelValidationError, action, type ActionContext, type ActionRecord } from "@/lib/orm";

export class Tarea extends Model {
  name = Fields.Text({ label: "Título", required: true, maxLength: 120, tracking: true, searchable: true });
  categoria = Fields.Many2one("EnsayoCategoria", { label: "Categoría", required: true, tracking: true });
  estado = Fields.Selection([
    { value: "pendiente", label: "Pendiente" },
    { value: "curso", label: "En curso" },
    { value: "hecha", label: "Hecha" },
  ], { label: "Estado", required: true, default: "pendiente", tracking: true });
  // Presentation options: the list policy (search, order, filters, groups) is declared on each Field.
  prioridad = Fields.Integer({ label: "Prioridad", min: 1, max: 5, default: 3, groupable: true });
  vence = Fields.DateTime({ label: "Vence" });

  // Business rules stay in the model and run on the server.
  normalize(values: Readonly<Record<string, unknown>>) {
    return { ...values, name: typeof values.name === "string" ? values.name.replace(/\s+/g, " ") : values.name };
  }
  // Business actions: published by name, executed by the service through the save pipeline.
  @action({ label: "Completar" })
  completar(record: ActionRecord<Tarea>) {
    if (record.estado === "hecha") throw new ModelValidationError("La tarea ya está hecha.");
    return { estado: "hecha" as const };
  }
  @action({ label: "Reabrir", groups: ["responsable"] })
  async reabrir(record: ActionRecord<Tarea>, context: ActionContext) {
    if (record.estado !== "hecha") throw new ModelValidationError("Sólo se reabren tareas hechas.");
    // Actions may read inside the same transaction (no external effects).
    await context.tx.user.findUniqueOrThrow({ where: { id: context.actor.id }, select: { id: true } });
    return { estado: "pendiente" as const };
  }
  // Not published: must never be executable by name.
  ayudante() { return { estado: "hecha" as const }; }

  beforeSave(values: Record<string, unknown>) {
    if (values.estado === "hecha" && values.prioridad === 5) throw new ModelValidationError("Revisa la tarea.", { prioridad: "Una tarea urgente no puede cerrarse sin revisión." });
    return values;
  }
}
