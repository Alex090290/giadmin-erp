import "server-only";
import { Fields } from "@/lib/orm";
import { defineModule } from "@/lib/modules/define";
import { extendModel } from "@/lib/modules/extend";
import { Partner } from "@/lib/core/models/partner";

/** Extends the native Partner: its fields live in crm_core_partner, owned by this module. */
const PartnerCrm = extendModel(Partner, Base => {
  class PartnerCrm extends Base {
    empresa = Fields.Text({ label: "Empresa", maxLength: 80, tracking: true });
  }
  return PartnerCrm;
});

export default defineModule({ id: "crm", name: "CRM", icon: "users", models: {}, extends: { "core.partner": PartnerCrm } });
