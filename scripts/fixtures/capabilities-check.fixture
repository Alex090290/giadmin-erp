import assert from "node:assert/strict";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { readAccessCapabilities } = await import("./src/lib/access/engine");
const { modelClientConfig, modelService, getModuleModel, withActor } = await import("./src/lib/modules/registry");
const { applicationNavigation } = await import("./src/lib/applications/navigation");
const { canOpenApplication } = await import("./src/lib/applications/manifest");
const { hashPassword } = await import("./src/lib/auth/password");

// Only copied/executed in the disposable project/schema by modules.integration.ts.
const password = await hashPassword("capabilities-test-only");
const adminUser = await prisma.user.create({ data: { login: "caps-admin", password, isAdmin: true } });
const readerUser = await prisma.user.create({ data: { login: "caps-reader", password } });
const managerUser = await prisma.user.create({ data: { login: "caps-manager", password } });
const admin = { id: adminUser.id, sessionVersion: adminUser.sessionVersion };
const reader = { id: readerUser.id, sessionVersion: readerUser.sessionVersion };
const manager = { id: managerUser.id, sessionVersion: managerUser.sessionVersion };
await prisma.accessUserGroup.createMany({ data: [{ userId: reader.id, groupId: "ensayo.usuario" }, { userId: manager.id, groupId: "ensayo.responsable" }] });
const snapshot = (actor: typeof admin) => prisma.$transaction(tx => readAccessCapabilities(tx, actor), { isolationLevel: "RepeatableRead" });
const tasks = modelService("ensayo.tarea");
const categories = modelService("ensayo.categoria");
const category = await categories.save(prisma, admin, { name: "Catálogo de capacidades", active: true });
assert.ok(category.ok);
const entry = getModuleModel("ensayo.tarea")!;
const record = await tasks.save(prisma, reader, { ...entry.entry.contract.createDefaults(), name: "Tarea propia", categoria: category.values.id });
assert.ok(record.ok);
const application = { ...entry.module.application, icon: (() => null) as never };
const state = { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] };

await prisma.accessModelOverride.create({ data: { groupId: "ensayo.usuario", model: "ensayo.tarea", read: true, create: false, write: false, unlink: false } });
const readonlyAccess = await snapshot(reader);
const readonlyConfig = modelClientConfig("ensayo.tarea", readonlyAccess);
assert.deepEqual(readonlyConfig.capabilities, { read: true, create: false, write: false, unlink: false, move: false });
assert.deepEqual(readonlyConfig.actions, []);
assert.deepEqual(readonlyConfig.kanbanTransitions, []);
assert.ok((await tasks.read(prisma, reader, record.values.id)).ok);
assert.ok((await withActor(reader, () => tasks.list(prisma, reader, state))).ok);
assert.equal((await tasks.save(prisma, reader, { ...record.values, name: "Intento falsificado" })).ok, false);
assert.equal((await tasks.save(prisma, reader, { ...entry.entry.contract.createDefaults(), name: "Nuevo denegado", categoria: category.values.id })).ok, false);
assert.equal((await tasks.action(prisma, reader, { action: "iniciar", id: record.values.id, revision: record.values.revision })).ok, false);
assert.equal((await tasks.move(prisma, reader, { id: record.values.id, revision: record.values.revision, from: "pendiente", to: "curso" })).ok, false);
assert.equal((await tasks.remove(prisma, reader, [{ id: record.values.id, revision: record.values.revision }])).ok, false);
const unchanged = await tasks.read(prisma, admin, record.values.id);
assert.ok(unchanged.ok);
assert.equal(unchanged.values.revision, record.values.revision);

const responsible = modelClientConfig("ensayo.tarea", await snapshot(manager));
assert.equal(responsible.capabilities?.write, true, "another inherited group grants write despite an override on usuario");
assert.equal(responsible.capabilities?.unlink, true);
assert.ok(responsible.actions.some(action => action.name === "reabrir"));
const superuser = modelClientConfig("ensayo.tarea", await snapshot(admin));
assert.equal(superuser.capabilities?.create, true);

await prisma.accessModelOverride.create({ data: { groupId: "ensayo.usuario", model: "ensayo.categoria", read: false, create: false, write: false, unlink: false } });
const withoutCatalog = await snapshot(reader);
assert.deepEqual(applicationNavigation(application, withoutCatalog)?.menus.map(menu => menu.id), ["tarea-list"]);
assert.equal((await categories.read(prisma, reader, category.values.id)).ok, false);
await prisma.accessModelOverride.updateMany({ where: { groupId: "ensayo.usuario", model: "ensayo.tarea" }, data: { read: false } });
assert.equal(canOpenApplication(application, await snapshot(reader)), false);
assert.equal((await tasks.read(prisma, reader, record.values.id)).ok, false);
await prisma.accessModelOverride.updateMany({ where: { groupId: "ensayo.usuario", model: "ensayo.categoria" }, data: { read: true } });
assert.deepEqual(applicationNavigation(application, await snapshot(reader))?.menus.map(menu => menu.id), ["configuracion-group"]);
await prisma.accessUserGroup.deleteMany({ where: { userId: reader.id } });
assert.equal(canOpenApplication(application, await snapshot(reader)), false);
await prisma.user.update({ where: { id: manager.id }, data: { sessionVersion: { increment: 1 } } });
await assert.rejects(snapshot(manager), /sesión/);
await prisma.user.update({ where: { id: reader.id }, data: { active: false } });
await assert.rejects(snapshot(reader), /sesión/);
await prisma.$disconnect();
