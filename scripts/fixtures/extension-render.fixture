import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { join } from "node:path";
import { setTimeout as delay } from "node:timers/promises";
import { createServer } from "node:net";

/** Real Next/RSC rendering of the lazy view inside the base RHF, on disposable data. */
export async function verifyExtensionForm() {
  const socket = createServer();
  await new Promise<void>((resolve, reject) => { socket.once("error", reject); socket.listen(0, "127.0.0.1", resolve); });
  const port = (socket.address() as { port: number }).port;
  await new Promise<void>((resolve, reject) => socket.close(error => error ? reject(error) : resolve()));
  const base = `http://127.0.0.1:${port}`;
  let output = "", stopped = false;
  const server = spawn(process.execPath, [join(process.cwd(), "node_modules/next/dist/bin/next"), "dev", "-p", String(port), "-H", "127.0.0.1"], {
    cwd: process.cwd(), env: { ...process.env, AUTH_URL: base }, stdio: ["ignore", "pipe", "pipe"], windowsHide: true,
  });
  server.stdout.on("data", chunk => { output = (output + chunk.toString()).slice(-5000); });
  server.stderr.on("data", chunk => { output = (output + chunk.toString()).slice(-5000); });
  const ended = new Promise<void>((resolve, reject) => {
    server.once("error", reject);
    server.once("exit", () => { stopped = true; resolve(); });
  });
  const cookies = new Map<string, string>();
  const request = async (path: string, init: RequestInit = {}) => {
    const headers = new Headers(init.headers);
    headers.set("cookie", [...cookies].map(([name, value]) => `${name}=${value}`).join("; "));
    const response = await fetch(base + path, { ...init, headers, redirect: "manual", signal: AbortSignal.timeout(240000) });
    for (const cookie of response.headers.getSetCookie()) {
      const pair = cookie.split(";")[0], index = pair.indexOf("=");
      cookies.set(pair.slice(0, index), pair.slice(index + 1));
    }
    return response;
  };
  try {
    let ready = false;
    for (let attempt = 0; attempt < 60 && !stopped; attempt++) {
      try { if ((await fetch(base + "/api/auth/csrf", { signal: AbortSignal.timeout(2000) })).ok) { ready = true; break; } } catch {}
      await delay(500);
    }
    assert.ok(ready, "El servidor temporal de formulario no inició.");
    const csrf = await (await request("/api/auth/csrf")).json();
    const login = await request("/api/auth/callback/credentials", { method: "POST", headers: { "content-type": "application/x-www-form-urlencoded", "x-auth-return-redirect": "1", origin: base }, body: new URLSearchParams({ login: "extension-root", password: "extension-test-only", csrfToken: csrf.csrfToken, callbackUrl: `${base}/erp` }) });
    assert.equal(login.status, 200);
    const response = await request("/erp/taller/equipo/nuevo");
    const html = await response.text();
    assert.equal(response.status, 200);
    assert.match(html, /data-extension="taller.equipo"/, "the lazy extension view renders under the base form");
    assert.match(html, /name="responsable"/, "the custom field shares RHF and published metadata");
    assert.match(html, /name="nivel"/);
    assert.match(html, /name="codigo"/);
    assert.equal((html.match(/<form\b/g) ?? []).length, 1, "only one form owns base and extension fields");
    console.log("✓ Next/RSC: vista diferida de extensión montada en el formulario base, Fields enlazados y un solo form/RHF.");
  } catch (error) {
    // Log only the bounded server output; the caller sanitizes its temporary database URL.
    console.error(output);
    throw error;
  } finally {
    if (!stopped) server.kill("SIGTERM");
    await ended;
  }
}
