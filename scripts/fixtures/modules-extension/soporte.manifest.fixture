import "server-only";
import { defineModule } from "@/lib/modules/define";
import { EquipoSoporte } from "./models/equipo";

/** Extension-only module: adds support fields to taller.equipo in its own companion table. */
export default defineModule({
  id: "soporte",
  name: "Soporte",
  icon: "life-buoy",
  depends: ["taller"],
  models: {},
  extends: { "taller.equipo": { model: EquipoSoporte, views: { form: () => import("./views/EquipoSoporte") } } },
  groups: { tecnico: { label: "Técnico", implies: ["taller.editor"] } },
  rules: [{ id: "nivel-tecnico", label: "Técnicos: nivel hasta 2", models: "taller.equipo", groups: ["tecnico"], domain: [{ field: "nivel", operator: "lte", value: 2 }] }],
});
