import assert from "node:assert/strict";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { modelService, modelClientConfig } = await import("./src/lib/modules/registry");
const { assignSequences } = await import("./src/lib/orm/sequence.server");
const { Fields } = await import("./src/lib/orm/fields");
const { hashPassword } = await import("./src/lib/auth/password");
const password = await hashPassword("series-test-only");
const user = await prisma.user.create({ data: { login: "series-editor", password } });
const reader = await prisma.user.create({ data: { login: "series-reader", password } });
await prisma.accessUserGroup.createMany({ data: [{ userId: user.id, groupId: "series.editor" }, { userId: reader.id, groupId: "series.reader" }] });
const actor = { id: user.id, sessionVersion: user.sessionVersion }, readonly = { id: reader.id, sessionVersion: reader.sessionVersion };
const service = modelService("series.ticket");
type Row = { id: string; revision: string; name: string; referencia: string; descripcion: string; estado: string };
const input = (descripcion = "Normal") => ({ name: "", referencia: "", descripcion, estado: "draft" });
const saved = async (values: unknown) => { const result = await service.save(prisma, actor, values); assert.ok(result.ok, JSON.stringify(result)); return result.values as Row; };
const counters = () => prisma.modelSequence.findMany({ orderBy: [{ key: "asc" }, { period: "asc" }] });
const fail = async (values: unknown, who = actor) => {
  const before = await counters(), rows = await prisma.seriesTicket.findMany({ orderBy: { id: "asc" } }), activities = await prisma.recordActivity.count();
  const result = await service.save(prisma, who, values); assert.equal(result.ok, false, JSON.stringify(result));
  assert.deepEqual(await counters(), before); assert.deepEqual(await prisma.seriesTicket.findMany({ orderBy: { id: "asc" } }), rows); assert.equal(await prisma.recordActivity.count(), activities);
};
for (const description of ["reject", "hook", "normalize", "late", "direct", ""]) await fail(input(description));
await fail({ ...input(), name: "FORGED" });
await fail(input(), readonly);
assert.equal(await prisma.modelSequence.count(), 0);
let one = await saved(input());
const year = String(new Date().getUTCFullYear());
assert.equal(one.name, `TCK-${year}-000001`); assert.equal(one.referencia, "REF-0001");
const counterBeforeEdit = await counters();
one = await saved({ ...one, descripcion: "Editado" });
assert.deepEqual(await counters(), counterBeforeEdit);
await fail({ ...one, name: "OTHER" });
await fail({ ...one, name: null });
await fail({ ...one, descripcion: "hook" });
await fail({ ...one, revision: "2000-01-01T00:00:00.000Z" });
const action = await service.action(prisma, actor, { action: "confirmar", id: one.id, revision: one.revision }); assert.ok(action.ok, JSON.stringify(action)); one = action.values as Row;
assert.equal(one.name, `TCK-${year}-000001`); assert.equal(one.estado, "done"); assert.deepEqual(await counters(), counterBeforeEdit);
const forged = await service.action(prisma, actor, { action: "forjar", id: one.id, revision: one.revision }); assert.equal(forged.ok, false);
const parallels = await Promise.all(Array.from({ length: 5 }, (_, index) => saved(input(`Concurrente ${index}`))));
assert.equal(new Set(parallels.map(row => row.name)).size, 5);
assert.deepEqual(parallels.map(row => row.name).sort(), [2,3,4,5,6].map(n => `TCK-${year}-${String(n).padStart(6,"0")}`));
const read = await service.read(prisma, actor, one.id); assert.ok(read.ok, JSON.stringify(read)); assert.equal(read.values.name, one.name);
const cfg = modelClientConfig("series.ticket"); assert.equal(cfg.fields.name.readOnly, true); assert.equal(cfg.fields.name.sequence?.reset, "year");
const temporal = { name: Fields.Text({ sequence: { prefix: "Y-{year}-", reset: "year", padding: 2 } }).metadata };
for (const [date, expected] of [["2026-12-31T23:59:59Z", "Y-2026-01"], ["2027-01-01T00:00:00Z", "Y-2027-01"], ["2026-12-31T23:59:59Z", "Y-2026-02"]]) {
  const allocated = await prisma.$transaction(tx => assignSequences(tx, "Temporal", temporal, {}, null, new Date(date)));
  assert.equal(allocated.values.name, expected);
}
const prior = await counters();
await assert.rejects(prisma.$transaction(async tx => { await assignSequences(tx, "Temporal", temporal, {}, null, new Date("2027-01-01Z")); throw new Error("rollback"); }));
assert.deepEqual(await counters(), prior);
const changed = { name: Fields.Text({ sequence: { prefix: "CHANGED-{year}-", reset: "year" } }).metadata };
await assert.rejects(prisma.$transaction(tx => assignSequences(tx, "Temporal", changed, {}, null, new Date("2027-01-01Z"))), /formato/);
assert.deepEqual(await counters(), prior);
const removed = await service.remove(prisma, actor, [{ id: one.id, revision: one.revision }]); assert.ok(removed.ok);
assert.equal((await saved(input())).name, `TCK-${year}-000007`); // issued numbers are never recycled after deletion
console.log("✓ Folios: unique allocation, independent fields/periods, UTC annual reset, forged payloads/actions/hooks, rollback, edits, permissions and concurrent creates.");
await prisma.$disconnect();
